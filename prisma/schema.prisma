generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Market {
  KOSPI
  KOSDAQ
  KONEX
  OTHER
}

enum RightsType {
  OFFICIAL_OPEN_DATA
  LICENSED
  METADATA_ONLY
  LINK_ONLY
  BLOCKED
}

enum SourceType {
  REGULATOR
  EXCHANGE
  GOVERNMENT
  COMPANY_IR
  MEDIA
  BROKER
  FUND
  CENTRAL_BANK
  PUBLIC_DATA
  INTERNATIONAL_ORG
}

enum EvidenceStatus {
  REGULATOR_CONFIRMED
  GOVERNMENT_CONFIRMED
  COMPANY_CONFIRMED
  LICENSED_SOURCE
  INFERRED
  UNVERIFIED
}

enum RelationshipType {
  SUPPLIER_TO
  CUSTOMER_OF
  PEER_OF
  JOINT_VENTURE_WITH
  STRATEGIC_PARTNER_OF
  SUBSIDIARY_OF
  PARENT_OF
  LICENSE_PARTNER_OF
}

enum EcosystemRoleType {
  MANUFACTURER
  MATERIAL_SUPPLIER
  EQUIPMENT_PROVIDER
  DESIGNER
  ASSEMBLY
  PACKAGING
  TESTING
  CUSTOMER
  INFRASTRUCTURE
  LOGISTICS
  OTHER
}

enum FactoryType {
  FAB
  ASSEMBLY_PLANT
  PACKAGING_SITE
  TEST_SITE
  MATERIALS_PLANT
  BATTERY_PLANT
  AUTO_PLANT
  SHIPYARD
  RND_CENTER
  INDUSTRIAL_CLUSTER
  OTHER
}

enum FactoryStatus {
  PLANNED
  UNDER_CONSTRUCTION
  OPERATING
  EXPANDING
  SUSPENDED
  CLOSED
  UNKNOWN
}

enum DisclosureEventType {
  EARNINGS
  DIVIDEND
  SHARE_BUYBACK
  SHARE_CANCELLATION
  CAPITAL_INCREASE
  BOND
  MERGER
  SPINOFF
  ACQUISITION
  MAJOR_CONTRACT
  OWNERSHIP_CHANGE
  INVESTMENT
  LITIGATION
  TRADING_STATUS
  COMPANY_IR
  POLICY
  REGULATION
  OTHER
}

model Company {
  id            String   @id @default(cuid())
  corpCode      String?  @unique
  ticker        String?  @unique
  slug          String?  @unique
  nameKo        String
  nameEn        String?
  country       String   @default("KR")
  market        Market?
  websiteUrl    String?
  irUrl         String?
  isActive      Boolean  @default(true)
  aliases       CompanyAlias[]
  roles         CompanyEcosystemRole[]
  factories     Factory[]
  disclosures   Disclosure[]
  relationsFrom CompanyRelationship[] @relation("RelationshipFrom")
  relationsTo   CompanyRelationship[] @relation("RelationshipTo")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([nameKo])
  @@index([nameEn])
  @@index([country])
}

model CompanyAlias {
  id        String  @id @default(cuid())
  companyId String
  alias     String
  language  String?
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([alias])
}

model Source {
  id             String     @id @default(cuid())
  name           String
  country        String?
  sourceType     SourceType
  homepageUrl    String?
  apiUrl         String?
  termsUrl       String?
  official       Boolean    @default(false)
  rightsType     RightsType @default(BLOCKED)
  canStore       Boolean    @default(false)
  canTranslate   Boolean    @default(false)
  canAnalyze     Boolean    @default(false)
  canCache       Boolean    @default(false)
  canShowTitle   Boolean    @default(false)
  canShowExcerpt Boolean    @default(false)
  canShowImage   Boolean    @default(false)
  verifiedAt     DateTime?
  licenseStart   DateTime?
  licenseEnd     DateTime?
  active         Boolean    @default(false)
  disclosures    Disclosure[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Disclosure {
  id             String              @id @default(cuid())
  companyId      String
  sourceId       String
  receiptNo      String              @unique
  reportName     String
  filerName      String?
  corpClass      String?
  filedAt        DateTime
  remarks        String?
  originalUrl    String
  eventType      DisclosureEventType @default(OTHER)
  language       String              @default("ko")
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source         Source              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([companyId, filedAt])
  @@index([filedAt])
  @@index([eventType])
}

model Ecosystem {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  active      Boolean  @default(true)
  stages      EcosystemStage[]
  products    Product[]
  roles       CompanyEcosystemRole[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EcosystemStage {
  id             String   @id @default(cuid())
  ecosystemId    String
  parentStageId  String?
  name           String
  sequence       Int
  ecosystem      Ecosystem @relation(fields: [ecosystemId], references: [id], onDelete: Cascade)
  parent         EcosystemStage? @relation("StageTree", fields: [parentStageId], references: [id])
  children       EcosystemStage[] @relation("StageTree")
  products       Product[]
  companyRoles   CompanyEcosystemRole[]

  @@unique([ecosystemId, sequence])
}

model Product {
  id              String   @id @default(cuid())
  ecosystemId     String
  stageId         String?
  name            String
  technologyGroup String?
  ecosystem       Ecosystem @relation(fields: [ecosystemId], references: [id], onDelete: Cascade)
  stage           EcosystemStage? @relation(fields: [stageId], references: [id])
  companyRoles    CompanyEcosystemRole[]
  relationships   CompanyRelationship[]
  factoryProducts FactoryProduct[]

  @@index([name])
}

model CompanyEcosystemRole {
  id             String             @id @default(cuid())
  companyId      String
  ecosystemId    String
  stageId        String?
  productId      String?
  roleType       EcosystemRoleType
  evidenceStatus EvidenceStatus
  sourceId       String?
  sourceUrl      String?
  verifiedAt     DateTime?
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ecosystem      Ecosystem          @relation(fields: [ecosystemId], references: [id], onDelete: Cascade)
  stage          EcosystemStage?    @relation(fields: [stageId], references: [id])
  product        Product?           @relation(fields: [productId], references: [id])

  @@index([ecosystemId, stageId])
  @@index([companyId])
}

model CompanyRelationship {
  id               String           @id @default(cuid())
  fromCompanyId    String
  toCompanyId      String
  ecosystemId      String?
  productId        String?
  relationshipType RelationshipType
  evidenceStatus   EvidenceStatus
  sourceId         String?
  sourceUrl        String?
  validFrom        DateTime?
  validTo          DateTime?
  verifiedAt       DateTime?
  fromCompany      Company          @relation("RelationshipFrom", fields: [fromCompanyId], references: [id], onDelete: Cascade)
  toCompany        Company          @relation("RelationshipTo", fields: [toCompanyId], references: [id], onDelete: Cascade)
  product          Product?         @relation(fields: [productId], references: [id])

  @@index([fromCompanyId, relationshipType])
  @@index([toCompanyId, relationshipType])
}

model Factory {
  id             String         @id @default(cuid())
  companyId      String
  name           String
  country        String
  region         String?
  city           String?
  latitude       Decimal?       @db.Decimal(9, 6)
  longitude      Decimal?       @db.Decimal(9, 6)
  factoryType    FactoryType    @default(OTHER)
  status         FactoryStatus  @default(UNKNOWN)
  openedAt       DateTime?
  sourceId       String?
  sourceUrl      String?
  evidenceStatus EvidenceStatus @default(UNVERIFIED)
  verifiedAt     DateTime?
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products       FactoryProduct[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([country, city])
  @@index([companyId, status])
}

model FactoryProduct {
  id             String         @id @default(cuid())
  factoryId      String
  productId      String
  productionRole String?
  capacityValue  Decimal?       @db.Decimal(20, 4)
  capacityUnit   String?
  capacityYear   Int?
  evidenceStatus EvidenceStatus @default(UNVERIFIED)
  sourceUrl      String?
  verifiedAt     DateTime?
  factory        Factory        @relation(fields: [factoryId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([factoryId, productId])
  @@index([productId])
}
